{
  "name": "@yugabytedb/prisma-adapter",
  "version": "7.8.0-yb-1",
  "description": "Prisma ORM driver adapter for the \"@yugabytedb/pg\" YugabyteDB smart driver",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yugabyte/prisma",
    "directory": "packages/prisma-adapter"
  },
  "scripts": {
    "dev": "DEV=true tsx helpers/build.ts && tsx helpers/postbuild.ts",
    "build": "tsx helpers/build.ts && tsx helpers/postbuild.ts",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [],
  "author": "Tom Houlé <houle@prisma.io>",
  "contributors": "Harsh Daryani <hdaryani@yugabyte.com>",
  "license": "Apache-2.0",
  "sideEffects": false,
  "dependencies": {
    "@prisma/driver-adapter-utils": "7.8.0",
    "@types/pg": "^8.16.0",
    "postgres-array": "3.0.4"
  },
  "peerDependencies": {
    "@yugabytedb/pg": "^8.7.3-yb-11"
  },
  "devDependencies": {
    "@prisma/debug": "7.8.0",
    "@yugabytedb/pg": "^8.7.3-yb-11"
  }
}
